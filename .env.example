# Local development only. Copy to .env when you need to override the defaults.
RABBITMQ_DEFAULT_USER=plinth
RABBITMQ_DEFAULT_PASS=plinth-local-dev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Local PostgreSQL service
POSTGRES_DB=plinth
POSTGRES_USER=plinth
POSTGRES_PASSWORD=plinth-local-dev
POSTGRES_PORT=5432

# Used by the Spring Boot broker profile.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=plinth
RABBITMQ_PASSWORD=plinth-local-dev
RABBITMQ_VHOST=/

# Used by the Spring Boot postgres profile.
DATABASE_URL=jdbc:postgresql://localhost:5432/plinth
DATABASE_USERNAME=plinth
DATABASE_PASSWORD=plinth-local-dev
